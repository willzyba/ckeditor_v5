{
  "name": "eqneditor-ckeditor5-demo",
  "version": "1.0.0",
  "private": true,
  "description": "The CKEditor 5 example on fxplugins.codecogs.com, bundled from npm sources",
  "type": "module",
  "scripts": {
    "build": "esbuild src/demo.js --bundle --preserve-symlinks --format=esm --alias:ckeditor5=./node_modules/ckeditor5 --minify --legal-comments=none --outfile=dist/eqneditor-ckeditor5-demo.js && node -e \"require('fs').copyFileSync('node_modules/ckeditor5/dist/ckeditor5.css','dist/ckeditor5.css')\"",
    "build:dev": "esbuild src/demo.js --bundle --preserve-symlinks --format=esm --alias:ckeditor5=./node_modules/ckeditor5 --outfile=dist/eqneditor-ckeditor5-demo.js && node -e \"require('fs').copyFileSync('node_modules/ckeditor5/dist/ckeditor5.css','dist/ckeditor5.css')\""
  },
  "dependencies": {
    "@codecogs/fxeditor-ckeditor5": "file:../plugin",
    "ckeditor5": "^48.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
